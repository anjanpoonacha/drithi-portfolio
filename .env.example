# BY DEFAULT THE PORT will be at 3000, but I want 8000
PORT=8000

# Vercel KV (Redis) Configuration
# Custom DRITHI_ prefixed environment variables
DRITHI_KV_REST_API_READ_ONLY_TOKEN="your_read_only_token_here"
DRITHI_KV_REST_API_TOKEN="your_token_here"
DRITHI_KV_REST_API_URL="https://your-kv-instance.upstash.io"
DRITHI_KV_URL="rediss://default:your_token_here@your-kv-instance.upstash.io:6379"
DRITHI_REDIS_URL="rediss://default:your_token_here@your-kv-instance.upstash.io:6379"

# Vercel Blob Storage Configuration
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"
BLOB_BASE_URL="https://your-blob-base-url.public.blob.vercel-storage.com"

# Admin Configuration
ADMIN_PASSWORD="your_secure_password_here"
